                <mxCell id="re_mw" value="" style="endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#0277bd;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mw" target="iwin"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ag_mw" value="1" style="endArrow=diamondThin;endFill=0;endSize=14;html=1;strokeColor=#00838f;strokeWidth=1.5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mw" target="imgr"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="d_e1" value="&amp;#171;use&amp;#187;" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#6a1b9a;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="emit" target="evmgr"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="d_e2" value="&amp;#171;use&amp;#187;" style="endArrow=open;endFill=0;endSize=10;dashed=1;html=1;strokeColor=#6a1b9a;strokeWidth=1.5;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="emit" target="input"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="note1" value="&lt;b&gt;Every backend window&lt;/b&gt; owns exactly one&lt;br/&gt;&lt;b&gt;EventEmitter&lt;/b&gt; by value, and every backend&lt;br/&gt;manager holds its windows by shared_ptr.&lt;br/&gt;&lt;br/&gt;Wayland is the exception in behaviour,&lt;br/&gt;not in structure: its manager owns the&lt;br/&gt;wl_seat and emits through the focused&lt;br/&gt;window's emitter." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#f9a825;fontColor=#f57f17;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="290" width="250" height="120" as="geometry"/></mxCell>
                <mxCell id="note2" value="&lt;b&gt;ManagedWindow&lt;/b&gt; is what IWindow::create()&lt;br/&gt;returns: it realizes IWindow and holds&lt;br/&gt;both the manager and the real window,&lt;br/&gt;so the manager outlives the window.&lt;br/&gt;It forwards every call, including getId()." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#f9a825;fontColor=#f57f17;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1290" y="430" width="250" height="105" as="geometry"/></mxCell>
                <mxCell id="lgbox" value="&lt;b&gt;UML notation&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#90a4ae;" vertex="1" parent="1"><mxGeometry x="1290" y="560" width="250" height="140" as="geometry"/></mxCell>
                <mxCell id="lgl0" value="" style="endArrow=block;endFill=0;endSize=12;dashed=1;html=1;strokeColor=#0277bd;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1305" y="595" as="sourcePoint"/><mxPoint x="1360" y="595" as="targetPoint"/></mxGeometry></mxCell>
